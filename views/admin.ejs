<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>HOMSelf 불출 관리</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jua&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/public/admin.css">
</head>
<body>
<header class="topbar">
  <a class="brand" href="/main">HOMSelf</a>
  <h1>불출 요청 관리</h1>
  <form id="login" class="pin-form">
    <input id="token" type="password" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" placeholder="관리자 PIN" autocomplete="off" required>
    <button class="pin-connect">연결</button>
    <button type="button" id="logout" class="pin-logout">로그아웃</button>
  </form>
</header>

<main>
  <section class="status-card" id="controls" hidden>
    <div class="status-main">
      <div>
        <span class="eyebrow">불출 상태</span>
        <h2 id="run-state">승인 선택 대기</h2>
        <p id="queue-state" class="queue-state"></p>
      </div>
      <div class="primary-actions">
        <button id="bulk-approve" class="bulk-approve-button">일괄승인</button>
        <button id="start-batch" class="release-button">일괄불출</button>
      </div>
    </div>
    <div class="status-sub">
      <span id="worker-state">회사 PC 연결 확인 중</span>
      <span id="message" role="status">요청 정보를 불러오는 중입니다.</span>
    </div>
    <div class="secondary-actions">
      <button id="pause" class="danger">불출 중지</button>
      <button id="refresh">새로고침</button>
      <button id="inspect">DB 보기</button>
      <button id="backup">SQLite 백업</button>
    </div>
  </section>

  <section class="board-grid">
    <section class="request-panel request-list-panel">
      <div class="section-title">
        <div><h2>요청 목록</h2></div>
        <div class="legend"><span class="legend-dot green"></span>승인 <span class="legend-dot red"></span>반려</div>
      </div>
      <div class="table-wrap request-table-wrap">
        <table>
          <thead><tr><th>접수 시각</th><th>매니저</th><th>자재</th><th>수량</th><th>상태</th><th>승인 / 반려</th></tr></thead>
          <tbody id="items"></tbody>
        </table>
      </div>
    </section>

    <aside class="approval-panel">
      <div class="approval-head">
        <div><span class="eyebrow">불출 대상</span><h2>승인 시트</h2></div>
        <span id="approval-count" class="approval-count">0건</span>
      </div>
      <div id="approval-sheet" class="approval-sheet"></div>
      <div id="approval-empty" class="approval-empty">승인된 요청이 없습니다.</div>
    </aside>
  </section>

  <section class="request-panel" id="db-panel" hidden>
    <div class="section-title"><div><h2>DB 구조 및 데이터</h2><span>각 테이블 최대 100행 미리보기</span></div></div>
    <pre id="db-view"></pre>
  </section>
</main>
<script src="/public/admin.js"></script>
</body>
</html>
