<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HOMSelf</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jua&display=swap" rel="stylesheet">

<link href="/public/main.css" rel="stylesheet"/>

</head>

<body>

<nav class="navbar navbar-dark bg-dark fixed-top">
<div class="container-fluid">
<a class="navbar-brand" href="/" id="homebt">HOMSelf</a>

<ul class="nav justify-content-center">
<li class="nav-item">
<a class="navbar-brand">매니저를 선택하세요</a>
</li>
</ul>

<button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasDarkNavbar">
<span class="navbar-toggler-icon"></span>
</button>

<div class="offcanvas offcanvas-end text-bg-dark" tabindex="-1" id="offcanvasDarkNavbar">
<div class="offcanvas-header">
<h5 class="offcanvas-title">관리자 모드</h5>
<button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
</div>

<div class="offcanvas-body">
<form class="d-flex mt-3" action="/admin">
<button class="btn btn-danger" type="submit">관리자로그인</button>
</form>
</div>
</div>

</div>
</nav>


<div id="pending-notice" role="alert" style="padding:1rem;margin-top:5rem" hidden></div>
<div class="row row-cols-3 row-cols-md-3 g-2" id="manager-lists"></div>



<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>

<script>

$(document).ready(async function(){

const catalog = await window.getHomselfCatalog();
if (!catalog) return;
let manager_list = catalog.managers;

for(let i=0;i<manager_list.length;i++){

let card = `
<div class="col">
<div class="card h-100">
<img src="/public/static/img/manager_list/${manager_list[i]}.jpg"
class="card-img-top"
style="height:100%;"
onclick="showMaterialList('${manager_list[i]}')">

<div class="card-body text-center">
<h4 class="card-title">${manager_list[i]}</h4>
</div>

</div>
</div>
`

$("#manager-lists").append(card)

}

})



function showMaterialList(managerName){

let encodedManagerName = encodeURIComponent(managerName)
window.location.href = `material_list?managerName=${encodedManagerName}`

}



let touchStartTime
let isDragging = false


document.addEventListener('contextmenu', function(event){
event.preventDefault()
})


document.addEventListener('touchstart', function(event){

touchStartTime = new Date().getTime()
isDragging = false

})


document.addEventListener('touchmove', function(event){

isDragging = true

})


document.addEventListener('touchend', function(event){

let touchEndTime = new Date().getTime()
let touchDuration = touchEndTime - touchStartTime

if(!isDragging && touchDuration > 300){

event.preventDefault()
event.target.click()

}

})



setInterval(()=>{

fetch('/ping',{
method:'GET',
cache:'no-store'
})
.then(res=>{
console.log("PING OK",new Date())
})
.catch(err=>{
console.log("PING FAIL",err)
location.reload()
})

},300000)



setInterval(()=>{

location.reload()

},3600000)



</script>

<script src="/public/request-client.js"></script>
</body>
</html>
