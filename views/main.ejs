<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8"><meta http-equiv="X-UA-Compatible" content="IE=edge"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>HOMSelf</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Jua&display=swap" rel="stylesheet"><link href="/public/main.css" rel="stylesheet"/>
</head>
<body>
<nav class="navbar navbar-dark bg-dark fixed-top"><div class="container-fluid"><a class="navbar-brand" href="/" id="homebt">HOMSelf</a><ul class="nav justify-content-center"><li class="nav-item"><a class="navbar-brand">매니저를 선택하세요</a></li></ul><button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasDarkNavbar"><span class="navbar-toggler-icon"></span></button><div class="offcanvas offcanvas-end text-bg-dark" tabindex="-1" id="offcanvasDarkNavbar"><div class="offcanvas-header"><h5 class="offcanvas-title">관리자 모드</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button></div><div class="offcanvas-body"><form class="d-flex mt-3" action="/admin"><button class="btn btn-danger" type="submit">관리자로그인</button></form></div></div></div></nav>
<div id="pending-notice" role="alert" style="padding:1rem;margin-top:5rem" hidden></div><div class="row row-cols-3 row-cols-md-3 g-2" id="manager-lists"></div>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"></script>
<script>
$(document).ready(async function(){
 const catalog=await window.getHomselfCatalog();if(!catalog)return;
 const settings=catalog.manager_settings||{};
 for(const name of catalog.managers||[]){
   const setting=settings[name]||{};if(setting.visible===false)continue;
   const col=document.createElement('div');col.className='col';
   const card=document.createElement('div');card.className='card h-100';
   const img=document.createElement('img');img.className='card-img-top';img.style.height='100%';img.alt=name;img.src=setting.image_data||('/public/static/img/manager_list/'+encodeURIComponent(name)+'.jpg');img.onclick=()=>showMaterialList(name);
   const body=document.createElement('div');body.className='card-body text-center';const title=document.createElement('h4');title.className='card-title';title.textContent=name;body.appendChild(title);card.append(img,body);col.appendChild(card);document.getElementById('manager-lists').appendChild(col);
 }
});
function showMaterialList(managerName){window.location.href='material_list?managerName='+encodeURIComponent(managerName);}
let touchStartTime,isDragging=false;document.addEventListener('contextmenu',e=>e.preventDefault());document.addEventListener('touchstart',()=>{touchStartTime=Date.now();isDragging=false;});document.addEventListener('touchmove',()=>{isDragging=true;});document.addEventListener('touchend',e=>{if(!isDragging&&Date.now()-touchStartTime>300){e.preventDefault();e.target.click();}});
setInterval(()=>fetch('/ping',{method:'GET',cache:'no-store'}).catch(()=>location.reload()),300000);setInterval(()=>location.reload(),3600000);
</script>
<script src="/public/request-client.js"></script>
</body></html>