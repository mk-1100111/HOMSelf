NODE_ENV=production
PORT=3000
# Free Render의 로컬 파일은 임시 저장소입니다. 운영 원본은 private HOMSelf-data에 저장/복원합니다.
DB_PATH=/tmp/homself.sqlite
CATALOG_PATH=/etc/secrets/catalog.json
EPHEMERAL_STORAGE_CONFIRMED=yes
# private mk-1100111/HOMSelf-data에서 catalog/요청상태/재고를 읽고 쓰는 GitHub 토큰.
# Fine-grained token: Repository access = HOMSelf-data, Contents = Read and write.
# 기존 HOMSELF_BACKUP_GITHUB_TOKEN이 같은 권한이면 그대로 재사용할 수 있습니다.
HOMSELF_CATALOG_GITHUB_TOKEN=
# ADMIN_TOKEN/KIOSK_TOKEN: 서로 다른 숫자 4자리 PIN.
# WORKER_TOKEN: 32자 이상의 내부 통신키. 실제 값은 Git에 올리지 마세요.
ADMIN_TOKEN=
KIOSK_TOKEN=
WORKER_TOKEN=