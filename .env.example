NODE_ENV=production
PORT=3000
# Node 24 LTS. Render: attach a Persistent Disk at /var/data BEFORE enabling production storage.
DB_PATH=/var/data/homself.sqlite
# Optional: when set, bootstrap forces DB_PATH to <dir>/homself.sqlite.
HOMSELF_PERSISTENT_DATA_DIR=/var/data
CATALOG_PATH=/var/data/catalog.json
PERSISTENT_STORAGE_CONFIRMED=no
# Render reads AND writes private mk-1100111/HOMSelf-data.
# Fine-grained token: Repository access = HOMSelf-data, Contents = Read and write.
# The same token can be used as HOMSELF_BACKUP_GITHUB_TOKEN if it already has this permission.
HOMSELF_CATALOG_GITHUB_TOKEN=
# ADMIN_TOKEN/KIOSK_TOKEN: 서로 다른 숫자 4자리 PIN.
# WORKER_TOKEN: 32자 이상의 내부 통신키. 실제 값은 Git에 올리지 마세요.
ADMIN_TOKEN=
KIOSK_TOKEN=
WORKER_TOKEN=