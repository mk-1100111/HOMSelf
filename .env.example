NODE_ENV=production
PORT=3000
# Node 24 LTS. Render: attach persistent disk at /var/data BEFORE first start.
DB_PATH=/var/data/homself.sqlite
CATALOG_PATH=/var/data/catalog.json
PERSISTENT_STORAGE_CONFIRMED=no
# Render 시작 시 private mk-1100111/HOMSelf-data/config/catalog.json 최신본을 읽기 위한 GitHub 토큰.
# fine-grained token으로 HOMSelf-data Contents: Read 권한만 부여하고 실제 값은 Git에 올리지 마세요.
HOMSELF_CATALOG_GITHUB_TOKEN=
# ADMIN_TOKEN/KIOSK_TOKEN: 서로 다른 숫자 4자리 PIN.
# WORKER_TOKEN: 32자 이상의 내부 통신키. 실제 값은 Git에 올리지 마세요.
ADMIN_TOKEN=
KIOSK_TOKEN=
WORKER_TOKEN=
