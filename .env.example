NODE_ENV=production
PORT=3000
# Free Render의 로컬 파일은 임시 저장소입니다. 운영 원본은 private HOMSelf-data에 저장/복원합니다.
DB_PATH=/tmp/homself.sqlite
CATALOG_PATH=/etc/secrets/catalog.json
EPHEMERAL_STORAGE_CONFIRMED=yes
# catalog/요청상태/재고는 private HOMSelf-data에 저장합니다.
# 관리자 부자재 사진 변경은 HOMSelf/public/static/img/material_list/<상품코드>.jpg 로 저장합니다.
# Fine-grained token을 재사용하려면 Repository access에 HOMSelf-data와 HOMSelf 두 저장소를 모두 선택하고 Contents = Read and write로 설정하세요.
HOMSELF_CATALOG_GITHUB_TOKEN=
# 선택: 이미지용 토큰을 분리하려면 HOMSelf 저장소 Contents Read and write 권한 토큰을 여기에 설정합니다.
# 비어 있으면 HOMSELF_CATALOG_GITHUB_TOKEN을 재사용합니다.
HOMSELF_APP_GITHUB_TOKEN=
# ADMIN_TOKEN/KIOSK_TOKEN: 서로 다른 숫자 4자리 PIN.
# WORKER_TOKEN: 32자 이상의 내부 통신키. 실제 값은 Git에 올리지 마세요.
ADMIN_TOKEN=
KIOSK_TOKEN=
WORKER_TOKEN=
